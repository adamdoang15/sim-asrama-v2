#!/bin/sh

# ==============================================================================
# Git Pre-Commit Hook: Format otomatis file PHP (Pint) & Frontend (Vite-Plus)
# ==============================================================================

echo "🔍 [Pre-Commit] Memeriksa file yang di-stage..."

# 1. Format file PHP jika ada yang di-stage
PHP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$')

if [ -n "$PHP_FILES" ]; then
    echo "🎨 [Pre-Commit] Menjalankan Pint pada file PHP..."
    if [ -f "vendor/bin/pint" ]; then
        ./vendor/bin/pint --dirty --quiet
    elif [ -f "vendor/bin/pint.bat" ]; then
        ./vendor/bin/pint.bat --dirty --quiet
    fi

    # Re-stage file PHP yang telah diformat
    for file in $PHP_FILES; do
        if [ -f "$file" ]; then
            git add "$file"
        fi
    done
fi

# 2. Format file frontend (JS/TS/TSX/CSS/JSON) jika ada yang di-stage
FRONTEND_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|jsx|ts|tsx|css|json)$')

if [ -n "$FRONTEND_FILES" ]; then
    echo "✨ [Pre-Commit] Menjalankan Vite-Plus (vp check --fix)..."
    npm run check:fix --silent 2>/dev/null || npx vp check --fix

    # Re-stage file frontend yang telah diformat
    for file in $FRONTEND_FILES; do
        if [ -f "$file" ]; then
            git add "$file"
        fi
    done
fi

echo "✅ [Pre-Commit] Semua file rapi dan siap di-commit!"
exit 0
